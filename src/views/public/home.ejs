<% const phoneHref = 'tel:+1' + g('biz.phone').replace(/\D/g, ''); const values = g('home.values').split(',').map(function (s) { return s.trim(); }).filter(Boolean); 
const I = (d) => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + d + '</svg>';
const ico = {
  phone: I('<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>'),
  cal: I('<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>'),
  pin: I('<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0z"/><circle cx="12" cy="10" r="3"/>'),
  globe: I('<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/>'),
  scale: I('<path d="M12 3v18M5 21h14M5 7h14M5 7l-3 7a3 3 0 0 0 6 0L5 7zM19 7l-3 7a3 3 0 0 0 6 0l-3-7z"/>'),
};
%>
<section class="hero hero-dark">
  <div class="wrap">
    <div>
      <p class="eyebrow"><%= g('home.eyebrow') %></p>
      <h1><%= g('home.title') %></h1>
      <p class="lead"><%= g('home.body') %></p>
      <div class="btn-row">
        <a class="btn btn-gold" href="<%= phoneHref %>"><%- ico.phone %><%= lang === 'es' ? t('cta.call') : g('home.btn_call') %> — <%= g('biz.phone') %></a>
        <a class="btn btn-light" href="/appointment"><%= lang === 'es' ? t('cta.schedule') : g('home.btn_schedule') %></a>
        <a class="btn btn-ghost" href="/contact"><%= lang === 'es' ? t('cta.contact') : g('home.btn_contact') %></a>
      </div>
      <p class="motto"><%= g('home.motto') %></p>
    </div>
    <div class="hero-art">
      <span class="ring" aria-hidden="true"></span><span class="ring ring-2" aria-hidden="true"></span>
      <% const heroImg = g('home.hero_image') || g('attorney.photo') || ''; const heroAlt = heroImg ? (g('home.hero_image_alt') || g('attorney.photo_alt') || '') : 'Placeholder portrait of an attorney'; %>
      <div class="hero-card hero-photo"><img src="<%= heroImg || '/img/attorney-placeholder.svg' %>" alt="<%= heroAlt %>" width="600" height="600" fetchpriority="high"></div>
      <ul class="float-chips" aria-label="At a glance">
        <li class="c1"><%- ico.scale %><span><%= lang === 'es' ? 'Abogada con licencia' : 'Licensed attorney' %><small><%= lang === 'es' ? 'en casos aceptados' : 'for matters accepted' %></small></span></li>
        <li class="c2"><%- ico.cal %><span><%= g('biz.hours_note') %><small><%= g('biz.hours').replace('Monday–Saturday', 'Mon–Sat') %></small></span></li>
        <li class="c3"><%- ico.globe %><span><%= g('biz.tagline_es') %><small>Everyone is welcome</small></span></li>
      </ul>
    </div>
  </div>
</section>

<div class="wrap action-cards-wrap">
  <ul class="action-cards">
    <li><a href="<%= phoneHref %>"><span class="ai"><%- ico.phone %></span><h3><%= t('cta.call') %></h3><p><%= g('biz.phone') %></p></a></li>
    <li><a href="/appointment"><span class="ai"><%- ico.cal %></span><h3><%= t('cta.schedule') %></h3><p><%= g('biz.hours_note') %></p></a></li>
    <li><a href="/contact"><span class="ai"><%- ico.pin %></span><h3><%= t('foot.visit') %></h3><p><%= g('biz.street') %>, <%= g('biz.city') %></p></a></li>
    <li><a href="/ayuda-de-inmigracion-en-espanol?lang=es"><span class="ai"><%- ico.globe %></span><h3>Ayuda en español</h3><p><%= g('biz.tagline_es') %></p></a></li>
  </ul>
</div>

<%- include('_flagband') %>

<section>
  <div class="wrap split">
    <div class="sec-head">
      <p class="eyebrow">Our community</p>
      <h2><%= g('home.flags_title') %></h2>
      <p class="lead"><%= g('home.flags_body') %></p>
    </div>
    <ul class="flagwall rv">
      <% flagsRow.forEach(function (f) { %><li><img src="/flags/<%= f[0] %>.svg" alt="" width="32" height="24" loading="lazy"><%= f[1] %></li><% }) %>
    </ul>
  </div>
</section>

<section class="band-paper">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Services</p>
      <h2><%= g('home.services_title') %></h2>
      <p class="lead"><%= g('home.services_body') %></p>
    </div>
    <ul class="svc-grid rv">
      <% services.forEach(function (s, i) { %>
      <li><a href="/services/<%= s.slug %>"><span class="n"><%= String(i + 1).padStart(2, '0') %></span><h3><%= s.title %></h3><p><%= s.summary %></p><span class="more"><%= t('cta.read') %> <span aria-hidden="true">→</span></span></a></li>
      <% }) %>
    </ul>
    <div class="btn-row"><a class="btn btn-line" href="/services"><%= t('cta.services') %> (<%= totalServices %>)</a></div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="sec-head"><p class="eyebrow"><%= t('home.how') %></p><h2>Three simple steps</h2></div>
    <ol class="steps rv">
      <li><h3><%= g('home.step1_title') %></h3><p><%= g('home.step1_body') %></p></li>
      <li><h3><%= g('home.step2_title') %></h3><p><%= g('home.step2_body') %></p></li>
      <li><h3><%= g('home.step3_title') %></h3><p><%= g('home.step3_body') %></p></li>
    </ol>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="duo">
      <div class="duo-dark">
        <p class="eyebrow"><%= t('home.attorney') %></p>
        <h2><%= g('attorney.name') %></h2>
        <p><%= g('attorney.note') %></p>
        <div class="btn-row"><a class="btn btn-gold" href="/attorney"><%= t('nav.attorney') %></a><a class="btn btn-ghost" href="/appointment"><%= t('cta.schedule') %></a></div>
      </div>
      <div class="duo-light">
        <p class="tagline-sm">What we stand for</p>
        <ul class="values"><% values.forEach(function (v) { %><li><%= v %></li><% }) %></ul>
      </div>
    </div>
  </div>
</section>

<% if (testimonials.length) { %>
<section>
  <div class="wrap narrow">
    <p class="eyebrow">Kind words</p>
    <% testimonials.forEach(function (x) { %><blockquote class="prose"><p><%= x.quote %></p><footer class="meta">— <%= x.name %><%= x.detail ? ', ' + x.detail : '' %></footer></blockquote><% }) %>
  </div>
</section>
<% } %>

<% if (posts.length) { %>
<section>
  <div class="wrap">
    <div class="sec-head"><p class="eyebrow"><%= t('home.latest') %></p><h2>Plain-language guides</h2></div>
    <ul class="posts">
      <% posts.forEach(function (p) { %><li><time datetime="<%= p.pub_date.slice(0, 10) %>"><%= u.fmtDate(p.pub_date) %></time><div><h3><a href="/blog/<%= p.slug %>"><%= p.title %></a></h3><p><%= p.excerpt || u.excerptOf(p.body) %></p></div></li><% }) %>
    </ul>
  </div>
</section>
<% } %>

<% if (faqs.length) { %>
<section class="band-paper">
  <div class="wrap split">
    <div class="sec-head"><p class="eyebrow"><%= t('home.faq') %></p><h2>Before you call</h2></div>
    <div class="faq">
      <% faqs.forEach(function (f) { %><details><summary><%= f.question %></summary><div class="ans"><%- f.answer %></div></details><% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="trust">
  <div class="wrap cols">
    <div><h3><%= t('foot.visit') %></h3><p><%= g('biz.street') %><br><%= g('biz.city') %>, <%= g('biz.state') %> <%= g('biz.zip') %></p></div>
    <div><h3><%= t('foot.hours') %></h3><p><%= g('biz.hours') %><br><strong><%= g('biz.hours_note') %></strong></p></div>
    <div><h3><%= t('cta.call') %></h3><p><a href="<%= phoneHref %>"><%= g('biz.phone') %></a><br><a href="mailto:<%= g('biz.email') %>"><%= g('biz.email') %></a></p></div>
  </div>
</section>

<section class="cta">
  <div class="wrap">
    <h2><%= g('home.cta_title') %></h2>
    <p><%= g('home.cta_body') %></p>
    <div class="btn-row"><a class="btn btn-gold" href="/appointment"><%= t('cta.schedule') %></a><a class="btn btn-line" style="color:#fff;border-color:#fff" href="<%= phoneHref %>"><%= t('cta.call') %> — <%= g('biz.phone') %></a></div>
  </div>
</section>
