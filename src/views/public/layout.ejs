<%
const phoneHref = 'tel:+1' + g('biz.phone').replace(/\D/g, '');
const addr = g('biz.street') + ', ' + g('biz.city') + ', ' + g('biz.state') + ' ' + g('biz.zip');
const ico = {
  phone: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>',
  cal: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>'
};
const robots = seo.noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large';
const switchTo = lang === 'es' ? 'en' : 'es';
%><!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= seo.title %></title>
<meta name="description" content="<%= seo.description %>">
<meta name="robots" content="<%= robots %>">
<link rel="canonical" href="<%= seo.canonical %>">
<% if (g('seo.google_verify')) { %><meta name="google-site-verification" content="<%= g('seo.google_verify') %>"><% } %>
<% if (g('seo.bing_verify')) { %><meta name="msvalidate.01" content="<%= g('seo.bing_verify') %>"><% } %>
<meta name="theme-color" content="#0c2a63">
<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= g('biz.name') %>">
<meta property="og:title" content="<%= seo.title %>">
<meta property="og:description" content="<%= seo.description %>">
<meta property="og:url" content="<%= seo.canonical %>">
<meta property="og:image" content="<%= seo.image %>">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" sizes="32x32" href="/img/icon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/img/icon-16.png">
<link rel="apple-touch-icon" href="/img/icon-180.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="alternate" type="application/rss+xml" title="<%= g('biz.name') %> Blog" href="/feed.xml">
<link rel="preload" href="/fonts/fraunces-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/site.css?v=1">
<% seo.jsonld.forEach(function (o) { %><script type="application/ld+json"><%- JSON.stringify(o).replace(/</g, '\\u003c') %></script>
<% }) %></head>
<body>
<a class="skip" href="#main"><%= t('skip') %></a>
<% if (user) { %><div class="editbar"><div class="wrap">Signed in as <%= user.name %> · <a href="/admin">Dashboard</a></div></div><% } %>
<div class="topbar"><div class="wrap">
  <span><%= g('biz.hours') %><span class="sep hide-sm">|</span><span class="hide-sm"><%= t('by_appt') %></span></span>
  <span class="hide-sm"><%= addr %></span>
  <span class="lang"><a href="?lang=en" <%- lang === 'en' ? 'aria-current="true"' : '' %> hreflang="en" lang="en">EN</a><span class="sep">/</span><a href="?lang=es" <%- lang === 'es' ? 'aria-current="true"' : '' %> hreflang="es" lang="es">ES</a></span>
</div></div>
<header class="hdr"><div class="wrap">
  <a class="brand" href="/" aria-label="<%= g('biz.name') %> — home">
    <img src="/img/logo-sm.webp" alt="The Immigrant Place — <%= g('biz.name') %>" width="104" height="65">
  </a>
  <nav class="nav" id="nav" aria-label="Main">
    <% headerNav.forEach(function (n) { const cur = n.url === '/' ? reqPath === '/' : reqPath === n.url || reqPath.startsWith(n.url + '/'); %>
    <a class="l" href="<%= n.url %>" <%- cur ? 'aria-current="page"' : '' %>><%= lang === 'es' && n.label_es ? n.label_es : n.label %></a>
    <% }) %>
    <div class="acts-m">
      <a class="btn btn-navy" href="<%= phoneHref %>"><%- ico.phone %> <%= t('cta.call') %> — <%= g('biz.phone') %></a>
      <a class="btn btn-gold" href="/appointment"><%= t('cta.schedule') %></a>
    </div>
  </nav>
  <div class="hdr-acts">
    <a class="icon-btn" href="<%= phoneHref %>" aria-label="<%= t('cta.call') %> <%= g('biz.phone') %>" title="<%= g('biz.phone') %>"><%- ico.phone %></a>
    <a class="cta-outline" href="/appointment"><%= t('cta.book') %> <span aria-hidden="true">→</span></a>
  </div>
  <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav"><%= t('menu') %></button>
</div></header>
<main id="main"><%- body %></main>
<footer class="ftr">
  <div class="wrap">
    <div class="cols">
      <div>
        <div class="plate"><img src="/img/logo-sm.webp" alt="<%= g('biz.name') %> — The Immigrant Place" width="150" height="94" loading="lazy"></div>
        <p style="margin-top:1rem"><strong style="color:#fff"><%= g('biz.name') %></strong><br><%= g('biz.tagline') %><br><em><%= g('biz.tagline_es') %></em></p>
      </div>
      <div>
        <h3><%= t('foot.explore') %></h3>
        <ul>
          <% footerNav.forEach(function (n) { %><li><a href="<%= n.url %>"><%= lang === 'es' && n.label_es ? n.label_es : n.label %></a></li><% }) %>
        </ul>
      </div>
      <div>
        <h3><%= t('foot.visit') %></h3>
        <p><%= g('biz.street') %><br><%= g('biz.city') %>, <%= g('biz.state') %> <%= g('biz.zip') %></p>
        <p><a href="<%= phoneHref %>"><%= g('biz.phone') %></a><br><a href="mailto:<%= g('biz.email') %>"><%= g('biz.email') %></a></p>
      </div>
      <div>
        <h3><%= t('foot.hours') %></h3>
        <p><%= g('biz.hours') %><br><strong style="color:#fff"><%= g('biz.hours_note') %></strong></p>
        <% if (g('biz.facebook') || g('biz.instagram')) { %><p><% if (g('biz.facebook')) { %><a href="<%= g('biz.facebook') %>" rel="noopener" target="_blank">Facebook</a><% } %><% if (g('biz.facebook') && g('biz.instagram')) { %> · <% } %><% if (g('biz.instagram')) { %><a href="<%= g('biz.instagram') %>" rel="noopener" target="_blank">Instagram</a><% } %></p><% } %>
      </div>
    </div>
    <div class="disclaimer" role="note" aria-label="Disclaimer">
      <% if (lang === 'es') { %><p lang="es"><%= g('biz.disclaimer_es') %></p><p lang="en"><%= g('biz.disclaimer') %></p>
      <% } else { %><p><%= g('biz.disclaimer') %></p><% } %>
    </div>
    <div class="copy">
      <span>© <%= new Date().getFullYear() %> <%= g('biz.name') %> <%= t('foot.rights') %></span>
      <span><a href="/privacy"><%= t('foot.privacy') %></a> · <a href="/terms"><%= t('foot.terms') %></a> · <a href="/accessibility"><%= t('foot.access') %></a></span>
    </div>
  </div>
</footer>
<div class="mbar">
  <a class="btn btn-navy" href="<%= phoneHref %>"><%- ico.phone %> <%= t('cta.call') %></a>
  <a class="btn btn-gold" href="/appointment"><%- ico.cal %> <%= lang === 'es' ? 'Cita' : 'Book' %></a>
</div>
<script src="/js/site.js?v=1" defer></script>
<% if (typeof pageScript !== 'undefined') { %><script src="<%= pageScript %>" defer></script><% } %>
</body>
</html>
