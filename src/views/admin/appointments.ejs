<div class="tabs"><% ['upcoming', 'past', 'all'].forEach(function (w) { %><a class="<%= w === when ? 'on' : '' %>" href="?when=<%= w %>&status=<%= st %>&q=<%= q %>"><%= w[0].toUpperCase() + w.slice(1) %></a><% }) %></div>
<div class="toolbar">
  <form method="get" class="toolbar" style="margin:0"><input type="hidden" name="when" value="<%= when %>">
    <input type="search" name="q" value="<%= q %>" placeholder="Name, phone or email" aria-label="Search">
    <select name="status" data-autosubmit aria-label="Status"><option value="">All statuses</option><% A_STATUS.forEach(function (s) { %><option <%= s === st ? 'selected' : '' %>><%= s %></option><% }) %></select>
    <button class="btn btn-line sm" type="submit">Filter</button></form>
  <a class="btn btn-line sm" href="/admin/closed-dates" style="margin-left:auto">Closed dates</a>
  <a class="btn btn-line sm" href="/admin/appointments/export.csv">Export CSV</a>
</div>
<div class="tblwrap"><table class="tbl"><thead><tr><th>When</th><th>Name</th><th>Contact</th><th>Service</th><th>Status</th><th></th></tr></thead><tbody>
<% if (!rows.length) { %><tr><td colspan="6" class="dim">No appointments match.</td></tr><% } %>
<% rows.forEach(function (a) { %><tr>
  <td><strong><%= fmtDate(a.date) %></strong><br><span class="dim small"><%= slotLabel(a.time) %></span></td>
  <td><a href="/admin/appointments/<%= a.id %>"><strong><%= a.name %></strong></a><br><span class="dim small"><%= a.language %></span></td>
  <td><a href="tel:<%= a.phone %>"><%= a.phone %></a><% if (a.email) { %><br><a class="small" href="mailto:<%= a.email %>"><%= a.email %></a><% } %></td>
  <td><%= a.service || '—' %></td><td><span class="pill <%= a.status %>"><%= a.status %></span></td>
  <td class="num"><a class="btn btn-line sm" href="/admin/appointments/<%= a.id %>">Open</a></td></tr><% }) %>
</tbody></table></div>
