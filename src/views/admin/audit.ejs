<form method="get" class="toolbar"><input type="search" name="q" value="<%= q %>" placeholder="Filter by action, user, detail" aria-label="Filter"><button class="btn btn-line sm" type="submit">Filter</button></form>
<div class="tblwrap"><table class="tbl"><thead><tr><th>When (UTC)</th><th>User</th><th>Action</th><th>Entity</th><th>Detail</th></tr></thead><tbody>
<% rows.forEach(function (r) { %><tr><td class="small dim"><%= r.created_at %></td><td class="small"><%= r.user_email || '—' %></td><td><strong><%= r.action %></strong></td><td class="small"><%= r.entity %></td><td class="small"><%= r.detail %></td></tr><% }) %>
</tbody></table></div>
<% if (pages > 1) { %><nav class="pager" aria-label="Pagination"><% for (let i = 1; i <= Math.min(pages, 20); i++) { %><% if (i === p) { %><span aria-current="page"><%= i %></span><% } else { %><a href="?page=<%= i %>&q=<%= q %>"><%= i %></a><% } %><% } %></nav><% } %>
<p class="dim small">The log is append-only from the dashboard. IPs are stored only as a daily-rotating hash.</p>
