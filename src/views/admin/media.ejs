<div class="card">
  <h2>Upload</h2>
  <form class="form" method="post" action="/admin/media/upload?_csrf=<%= csrfToken() %>" enctype="multipart/form-data" style="max-width:640px">
    <div><label for="files">Images (JPG, PNG, WebP, GIF) or PDF — up to 8 MB each</label><input id="files" type="file" name="files" multiple accept="image/jpeg,image/png,image/webp,image/gif,application/pdf" required></div>
    <div><label for="alt">Alt text (describe the image for people who cannot see it)</label><input id="alt" type="text" name="alt" maxlength="200"><p class="help">Required for images. Images are resized, converted to WebP and stripped of metadata (location, camera).</p></div>
    <div><button class="btn btn-navy" type="submit">Upload</button></div>
  </form>
</div>
<form method="get" class="toolbar"><input type="search" name="q" value="<%= q %>" placeholder="Search media" aria-label="Search media"><button class="btn btn-line sm" type="submit">Search</button></form>
<% if (!rows.length) { %><p class="dim">No files yet.</p><% } %>
<div class="mgrid">
<% rows.forEach(function (m) { %>
  <div class="mcard">
    <% if (/\.pdf$/.test(m.url)) { %><div class="pdf">PDF</div><% } else { %><img src="<%= m.url %>" alt="<%= m.alt %>" loading="lazy"><% } %>
    <div class="b">
      <strong class="small"><%= m.filename %></strong>
      <code><%= m.url %></code>
      <form method="post" action="/admin/media/<%= m.id %>" style="display:grid;gap:.3rem"><input type="hidden" name="_csrf" value="<%= csrfToken() %>"><input type="text" name="alt" value="<%= m.alt %>" aria-label="Alt text" placeholder="Alt text"><button class="btn btn-line sm" type="submit">Save alt</button></form>
      <form method="post" action="/admin/media/<%= m.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken() %>"><button class="btn btn-danger sm" type="submit" data-confirm="Delete this file? (Blocked if it is still used.)">Delete</button></form>
    </div>
  </div>
<% }) %>
</div>
