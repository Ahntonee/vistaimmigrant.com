<%
const qs = function (o) { const p = new URLSearchParams(Object.assign({}, query, o)); Array.from(p.keys()).forEach(function (k) { if (!p.get(k)) p.delete(k); }); const s = p.toString(); return s ? '?' + s : ''; };
const sortKeys = cfg.cols.map(function (c) { return c[0]; });
%>
<div class="toolbar">
  <form method="get" class="toolbar" style="margin:0" role="search">
    <input type="search" name="q" value="<%= q %>" placeholder="Search <%= cfg.label.toLowerCase() %>…" aria-label="Search">
    <% cfg.filters.forEach(function (f) { %><select name="<%= f.n %>" aria-label="Filter by <%= f.n %>" data-autosubmit><option value="">All <%= f.n %></option><% f.opts.forEach(function (o) { %><option value="<%= o[0] %>" <%= query[f.n] === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select><% }) %>
    <% if (cfg.soft && trash) { %><input type="hidden" name="trash" value="1"><% } %>
    <button class="btn btn-line sm" type="submit">Search</button>
  </form>
  <% if (cfg.soft) { %><a class="btn btn-line sm" href="/admin/<%= key %><%= trash ? '' : '?trash=1' %>"><%= trash ? '← Back to list' : 'Trash' %></a><% } %>
  <a class="btn btn-navy sm" href="/admin/<%= key %>/new" style="margin-left:auto">+ New <%= cfg.one %></a>
</div>
<form method="post" action="/admin/<%= key %>/bulk">
<input type="hidden" name="_csrf" value="<%= csrfToken() %>">
<div class="tblwrap"><table class="tbl">
  <thead><tr>
    <% if (cfg.bulk && !trash) { %><th class="num"><input type="checkbox" data-checkall aria-label="Select all"></th><% } %>
    <% cfg.cols.forEach(function (c) { %><th><a href="<%= qs({ sort: c[0], dir: query.sort === c[0] && query.dir !== 'asc' ? 'asc' : 'desc' }) %>"><%= c[1] %><%= query.sort === c[0] ? (query.dir === 'asc' ? ' ↑' : ' ↓') : '' %></a></th><% }) %>
    <th class="num">Actions</th>
  </tr></thead>
  <tbody>
  <% if (!rows.length) { %><tr><td colspan="<%= cfg.cols.length + 2 %>" class="dim">Nothing here yet.</td></tr><% } %>
  <% rows.forEach(function (r) { %>
    <tr>
      <% if (cfg.bulk && !trash) { %><td class="num"><input type="checkbox" name="ids" value="<%= r.id %>" aria-label="Select <%= r.title || r.name %>"></td><% } %>
      <% cfg.cols.forEach(function (c) { const v = r[c[0]]; %>
        <td>
        <% if (c[2] === 'link') { %><a href="/admin/<%= key %>/<%= r.id %>/edit"><strong><%= v %></strong></a>
        <% } else if (c[2] === 'badge') { %><span class="pill <%= v %>"><%= v %></span><% if (v === 'scheduled' && r.publish_at) { %><br><span class="dim small"><%= r.publish_at %> UTC</span><% } %>
        <% } else if (c[2] === 'bool') { %><span class="pill <%= v ? 'ok' : 'draft' %>"><%= v ? 'Yes' : 'No' %></span>
        <% } else if (c[2] === 'date') { %><span class="dim small"><%= v ? fmtDate(v) : '' %></span>
        <% } else if (c[2] === 'slug') { %><code class="small"><%= cfg.url ? cfg.url(v) : v %></code>
        <% } else { %><%= v %><% } %>
        </td>
      <% }) %>
      <td class="num">
        <% if (cfg.sortable && !query.sort) { %>
          <button class="btn btn-line sm" type="submit" formaction="/admin/<%= key %>/<%= r.id %>/move" name="dir" value="up" aria-label="Move up">↑</button>
          <button class="btn btn-line sm" type="submit" formaction="/admin/<%= key %>/<%= r.id %>/move" name="dir" value="down" aria-label="Move down">↓</button>
        <% } %>
        <% if (cfg.url && r.slug && (r.status === 'published' || r.published === 1) && !r.deleted) { %><a class="btn btn-line sm" href="<%= cfg.url(r.slug) %>" target="_blank" rel="noopener">View</a><% } %>
        <a class="btn btn-line sm" href="/admin/<%= key %>/<%= r.id %>/edit">Edit</a>
        <% if (trash) { %><button class="btn btn-line sm" type="submit" formaction="/admin/<%= key %>/<%= r.id %>/restore">Restore</button><% } %>
        <button class="btn btn-danger sm" type="submit" formaction="/admin/<%= key %>/<%= r.id %>/delete" data-confirm="<%= cfg.soft && !trash ? 'Move this to the trash?' : 'Delete permanently? This cannot be undone.' %>"><%= cfg.soft && !trash ? 'Trash' : 'Delete' %></button>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table></div>
<% if (cfg.bulk && !trash) { %>
<div class="toolbar" style="margin-top:.75rem">
  <select name="action" aria-label="Bulk action"><option value="publish">Publish selected</option><option value="unpublish">Unpublish selected</option><option value="trash">Move selected to trash</option></select>
  <button class="btn btn-line sm" type="submit" formaction="/admin/<%= key %>/bulk" data-confirm="Apply to the selected items?">Apply</button>
</div>
<% } %>
</form>
<% if (pages > 1) { %><nav class="pager" aria-label="Pagination"><% for (let i = 1; i <= pages; i++) { %><% if (i === p) { %><span aria-current="page"><%= i %></span><% } else { %><a href="<%= qs({ page: i }) %>"><%= i %></a><% } %><% } %></nav><% } %>
<p class="dim small"><%= total %> item<%= total === 1 ? '' : 's' %></p>
