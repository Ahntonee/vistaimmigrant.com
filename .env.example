# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# Required in production: 32+ random characters (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
SESSION_SECRET=

# Set to true when running behind nginx / a load balancer so secure cookies and client IPs work
TRUST_PROXY=false

# First owner account created by `npm run seed`.
# Production: ADMIN_PASSWORD is REQUIRED (12+ chars, upper/lower/number). Development: if blank, one is generated into .env.
ADMIN_EMAIL=Vistaimmigrantsupport@gmail.com
ADMIN_PASSWORD=

# Require two-step sign-in for every owner account (recommended once set up)
REQUIRE_OWNER_2FA=false

# Email (without SMTP_HOST, emails are only recorded in Admin → Email outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vista Immigrant Support <Vistaimmigrantsupport@gmail.com>"

# Optional: custom database file location
# DB_FILE=./data/vista.db
